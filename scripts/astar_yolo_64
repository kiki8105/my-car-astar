#!/usr/bin/env bash
set -eo pipefail

WORKSPACE=/home/kiki/turtlebot3
PACKAGE_DIR="$WORKSPACE/src/my_car_astar"
VENV_SITE_PACKAGES=("$PACKAGE_DIR"/.venv/lib/python*/site-packages)

if [[ ! -d "${VENV_SITE_PACKAGES[0]}" ]]; then
  echo "가상환경이 없습니다: $PACKAGE_DIR/.venv" >&2
  echo "README.md의 Python 의존성 설치 명령을 먼저 실행하세요." >&2
  exit 1
fi

source /opt/ros/humble/setup.bash
source "$WORKSPACE/install/setup.bash"
export ROS_DOMAIN_ID=64
export ROS_LOCALHOST_ONLY=0
export TURTLEBOT3_MODEL=waffle_pi
export PYTHONPATH="${VENV_SITE_PACKAGES[0]}:${PYTHONPATH:-}"

cd "$WORKSPACE"
exec ros2 launch my_car_astar astar_drive.launch.py "$@"